# BC-768 の BLE UUID 設定サンプル。
# このファイルをコピーして .env を作り、実値を書き込む（.env は git 管理外）。
#
#   cp .env.example .env
#
# 実値は仕様書・docs・ソースコードには絶対に記載しない。
# 環境変数を直接 export しても同じキー名で読み込まれる（環境変数が .env より優先）。

BC768_SERVICE_UUID=
BC768_WRITE_CHAR_1=
BC768_WRITE_CHAR_2=
BC768_NOTIFY_CHAR_1=
BC768_NOTIFY_CHAR_2=
BC768_NOTIFY_CHAR_3=

# handshake コマンドで使う値。Android HCI キャプチャから読み取ったもの。
# BC768_CLIENT_ID       : 0x0003 で送るクライアント識別子（36 文字の UUID 文字列）
# BC768_CMD_0010_PAYLOAD: 0x0010 で送る payload（hex 9 バイト）
BC768_CLIENT_ID=
BC768_CMD_0010_PAYLOAD=
